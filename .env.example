# =============================================================================
#  IRIS V3 — environment template
# =============================================================================
#  Copy to .env and edit. Every image tag is pinned by IRIS_VERSION so the
#  four services roll together. All __MUST_BE_CHANGED__ values must be set.

# -- VERSION
# Single knob that pins iris-backend, iris-db, iris-nginx, and
# iris-frontend image tags together. Updated by scripts/bump-version.sh.
IRIS_VERSION=v3.0.0-beta.1

# -- LOGGING
LOG_LEVEL=info

# -- HOSTNAME (single source of truth)
# Provides fallback defaults for SERVER_NAME (nginx),
# PUBLIC_EXTERNAL_API_URL / ORIGIN (SvelteKit), and VITE_ALLOWED_HOSTS
# (Vite dev). Explicit values still take precedence for split-hostname
# deployments (e.g. API on a different host than UI).
IRIS_HOSTNAME=localhost

# -- NGINX
SERVER_NAME=
# When both KEY_FILENAME and CERT_FILENAME are unset AND certbot's
# standard fullchain.pem + privkey.pem pair exist under
# ./certificates/web_certificates/, the nginx entrypoint autodetects
# them — useful for Let's Encrypt setups.
KEY_FILENAME=iris_dev_key.pem
CERT_FILENAME=iris_dev_cert.pem
# Nginx polls the cert file's mtime every N seconds and reloads on
# change so certbot renewals apply without a container restart. Set
# to 0 to disable if your deployment reloads nginx externally.
IRIS_CERT_RELOAD_INTERVAL=60
INTERFACE_HTTPS_PORT=443

# -- DATABASE
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__MUST_BE_CHANGED__
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=__MUST_BE_CHANGED__
POSTGRES_DB=iris_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# -- IRIS APP
DOCKERIZED=1
IRIS_SECRET_KEY=__MUST_BE_CHANGED__
IRIS_SECURITY_PASSWORD_SALT=__MUST_BE_CHANGED__
IRIS_UPSTREAM_SERVER=app
IRIS_UPSTREAM_PORT=8000
IRIS_FRONTEND_SERVER=frontend
IRIS_FRONTEND_PORT=5173

# -- WORKER
CELERY_BROKER=amqp://rabbitmq

# -- AUTH
IRIS_AUTHENTICATION_TYPE=local
# Optional: set the admin credentials seeded on first boot. If unset,
# the app prints the generated admin password to stdout the first
# time it starts.
#IRIS_ADM_USERNAME=administrator
#IRIS_ADM_PASSWORD=
#IRIS_ADM_EMAIL=admin@localhost
#IRIS_ADM_API_KEY=

# -- CUSTOM CA CERTIFICATES (Keycloak, LDAPS, webhooks, ...)
# Drop one or more *.crt / *.pem files into ./certificates/ca-bundle/
# on the host — they are mounted at /etc/iris-ca/ inside the app and
# worker containers, and installed into the OS trust store. Additive:
# system roots stay trusted.
#
# Legacy single-file bundle mode (REPLACES the default trust store):
#REQUESTS_CA_BUNDLE=/etc/iris-ca/extra-ca.crt
#SSL_CERT_FILE=/etc/iris-ca/extra-ca.crt
