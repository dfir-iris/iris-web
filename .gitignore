.DS_Store
.env
.env.local
.idea/
.vscode/
*.code-workspace

# Submodules' working dirs — pointer commits are tracked, contents are not.
iris-backend/*
iris-frontend/*
!iris-backend/.git
!iris-frontend/.git

# Dev artifacts that may show up when the build overlay is used
backups/
venv/
node_modules/

# TLS material — never commit private keys or certs; scripts/dev-up.sh
# generates a self-signed pair on first run for local dev.
certificates/web_certificates/*
!certificates/web_certificates/.gitkeep
certificates/ca-bundle/*
!certificates/ca-bundle/.gitkeep
certificates/ldap/*
!certificates/ldap/.gitkeep
# Agent scratch — local to whoever is running one, not part of the repo.
.claude/*
CLAUDE.md
docs/superpowers/*

# Internal working documents. Everything else in docs/ ships to the public repo
# as user-facing documentation, so anything written for the team only — CI
# failure triage, release-readiness reviews, security advisories, session
# write-ups — must be kept out by pattern. Keep the live copies outside every
# repo, not merely untracked: an untracked file in docs/ is one `git add` away
# from being published, and `git add -f` defeats this list entirely.
docs/*-triage.md
docs/ci-*.md
docs/release-readiness-*.md
docs/security-advisory-*.md
docs/*-review-*.md
.ci-artifact-prev/
.ci-artifact/
.ci-testapi-prev.log
.ci-testapi-prev.log.fails
.ci-testapi.log
.ci-testapi.log.fails