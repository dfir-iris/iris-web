.DS_Store
.env
.env.local
.idea/
.vscode/
*.code-workspace

# Submodules' working dirs — pointer commits are tracked, contents are not.
iris-backend/*
iris-frontend/*
!iris-backend/.git
!iris-frontend/.git

# Dev artifacts that may show up when the build overlay is used
backups/
venv/
node_modules/

# TLS material — never commit private keys or certs; scripts/dev-up.sh
# generates a self-signed pair on first run for local dev.
certificates/web_certificates/*
!certificates/web_certificates/.gitkeep
certificates/ca-bundle/*
!certificates/ca-bundle/.gitkeep
certificates/ldap/*
!certificates/ldap/.gitkeep
.claude/*
docs/superpowers/*